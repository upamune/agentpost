{
  "name": "agentpost",
  "version": "0.1.2",
  "private": true,
  "description": "Create as many email addresses as your AI agents need. Send and receive mail on your own domain with an API, CLI, and MCP.",
  "homepage": "https://github.com/upamune/agentpost#readme",
  "bugs": "https://github.com/upamune/agentpost/issues",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/upamune/agentpost.git"
  },
  "bin": {
    "agentpost": "./src/cli.ts"
  },
  "type": "module",
  "scripts": {
    "setup:local": "bun run scripts/setup-local.ts",
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "knip": "knip",
    "typecheck": "tsc --noEmit",
    "test": "bun run test:worker && bun test ./test/client.bun.ts ./test/adversarial-client.bun.ts ./test/security-workflows.bun.ts ./test/release.bun.ts ./test/release-workflow.bun.ts ./test/formal-runner.bun.ts ./test/complexity.bun.ts ./test/refactor-contracts.bun.ts ./test/executables.bun.ts ./test/npm.bun.ts",
    "test:worker": "vitest run",
    "fuzz": "bun test ./test/security.fuzz.ts",
    "mcp": "bun run src/mcp.ts",
    "smoke:local": "bun run scripts/local-smoke.ts",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "deploy:check": "bun run scripts/deploy-check.ts",
    "deploy": "bun run deploy:check && wrangler deploy",
    "cli": "bun run src/cli.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.4.0",
    "hono": "^4.13.13",
    "jose": "6.2.13",
    "postal-mime": "^4.1.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@cloudflare/workers-types": "^5.20261024.1",
    "@modelcontextprotocol/client": "2.4.0",
    "@types/bun": "^1.4.4",
    "fast-check": "4.10.2",
    "knip": "^6.42.1",
    "oxfmt": "^0.74.0",
    "oxlint": "^1.89.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  },
  "overrides": {
    "undici": "7.30.1",
    "zod": "4.6.7"
  }
}
