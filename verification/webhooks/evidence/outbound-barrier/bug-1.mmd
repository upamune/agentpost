---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  %% second model (against): Guarded implementation
  classDef plainWrong fill:#f4f6f7,stroke:#c0392b,stroke-width:4px,color:#7b241c
  classDef plainFixed fill:#f4f6f7,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group0 fill:#d6eaf8,stroke:#6b757c,color:#1b2631
  classDef group0Fixed fill:#d6eaf8,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group0Path fill:#d6eaf8,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  classDef group3 fill:#fcf3cf,stroke:#7e7a68,color:#1b2631
  classDef group3Wrong fill:#fcf3cf,stroke:#c0392b,stroke-width:4px,color:#7b241c
  state "Legend" as legend {
    state "Dispatch barrier protocol" as legendGroup0
    state "Unsafe request started" as legendGroup3
    state "Breaks a rule" as legendWrong
    state "Only in Guarded implementation" as legendFixed
  }
  class legendGroup0 group0
  class legendGroup3 group3
  class legendWrong plainWrong
  class legendFixed plainFixed
  state "A disabled inbox or<br/>replaced worker started an<br/>email request" as s0
  state "barrier; inbox enabled;<br/>worker 2; inbox update 0;<br/>old disable still in<br/>flight" as s1
  state "idle; inbox enabled;<br/>worker 1; inbox update 0;<br/>no old disable in flight" as s2
  state "idle; inbox enabled;<br/>worker 1; inbox update 0;<br/>old disable still in<br/>flight" as s3
  state "idle; inbox enabled;<br/>worker 2; inbox update 0;<br/>old disable still in<br/>flight" as s4
  state "prepared; inbox enabled;<br/>worker 2; inbox update 0;<br/>old disable still in<br/>flight" as s5
  state "verified; inbox disabled;<br/>worker 2; inbox update 1;<br/>no old disable in flight" as s6
  state "verified; inbox enabled;<br/>worker 2; inbox update 0;<br/>old disable still in<br/>flight" as s7
  [*] --> s2
  s2 --> s3 : 1. An old worker starts an<br/>awaited inbox disable
  s3 --> s4 : 2. A replacement worker takes<br/>ownership
  s4 --> s5 : 3. Read inbox state and<br/>prepare the email provider<br/>payload
  s5 --> s7 : 4. Reserve an ownership<br/>sequence for the dispatch<br/>barrier
  s7 --> s6 : 5. The old inbox disable<br/>finally reaches D1
  s6 --> s0 : 6. Fence current ownership and<br/>start the email provider<br/>request
  s5 --> s1 : in Guarded implementation,<br/>Reserve an ownership sequence<br/>for the dispatch barrier
  class s0 group3Wrong
  class s1 group0Fixed
  class s2 group0Path
  class s3 group0Path
  class s4 group0Path
  class s5 group0Path
  class s6 group0Path
  class s7 group0Path
