---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  %% second model (fix): the fix
  classDef plainFixed fill:#f4f6f7,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group0 fill:#d6eaf8,stroke:#6b757c,color:#1b2631
  classDef group0Fixed fill:#d6eaf8,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group1 fill:#fdebd0,stroke:#7f7668,color:#1b2631
  classDef group1Path fill:#fdebd0,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  state "Legend" as legend {
    state "Disable overwritten" as legendGroup0
    state "Within the checked rule" as legendGroup1
    state "Fixed or new with the fix" as legendFixed
  }
  class legendGroup0 group0
  class legendGroup1 group1
  class legendFixed plainFixed
  state "Inbox disabled; stored<br/>update 2; old enable<br/>finished; new disable<br/>completed" as s0
  state "Inbox disabled; stored<br/>update 2; old enable still<br/>in flight; new disable<br/>completed" as s1
  state "Inbox enabled; stored<br/>update 0; old enable still<br/>in flight; new disable in<br/>flight" as s2
  state "Inbox enabled; stored<br/>update 1; old enable<br/>finished; new disable<br/>completed" as s3
  [*] --> s2
  s2 --> s1 : 1. New disable commits
  s1 --> s3 : 2. Old enable arrives late
  s1 --> s0 : with the fix, Old enable<br/>arrives late
  class s0 group1Path
  class s1 group1Path
  class s2 group1Path
  class s3 group0Fixed
