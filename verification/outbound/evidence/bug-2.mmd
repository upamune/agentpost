---
config:
  markdownAutoWrap: false
  state:
    useMaxWidth: false
---
stateDiagram-v2
  %% second model (fix): the fix
  classDef plainFixed fill:#f4f6f7,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group0 fill:#d6eaf8,stroke:#6b757c,color:#1b2631
  classDef group0Fixed fill:#d6eaf8,stroke:#1e8449,stroke-width:4px,color:#145a32
  classDef group1 fill:#fdebd0,stroke:#7f7668,color:#1b2631
  classDef group1Path fill:#fdebd0,stroke:#1f3a93,stroke-width:4px,color:#1b2631
  state "Legend" as legend {
    state "Needs review" as legendGroup0
    state "Within the checked rules" as legendGroup1
    state "Fixed or new with the fix" as legendFixed
  }
  class legendGroup0 group0
  class legendGroup1 group1
  class legendFixed plainFixed
  state "Inbox enabled; Earlier<br/>check said inbox enabled;<br/>unknown; accepted 0" as s0
  state "Inbox enabled; Queued for<br/>a worker; pending;<br/>accepted 0" as s1
  state "Inbox enabled; Worker<br/>claimed request; sending;<br/>accepted 0" as s2
  state "Inbox enabled; Worker<br/>claimed request; unknown;<br/>accepted 0" as s3
  state "Outcome unknown but old<br/>worker starts sending" as s4
  [*] --> s1
  s1 --> s2 : 1. Worker claims queued<br/>request
  s2 --> s3 : 2. Cron marks stale request<br/>outcome unknown
  s3 --> s0 : 3. Read whether inbox is<br/>enabled
  s0 --> s4 : 4. Start a request to the<br/>email provider
  s0 --> s0 : with the fix, Start a request<br/>to the email provider cannot<br/>happen at step 4
  class s0 group1Path
  class s1 group1Path
  class s2 group1Path
  class s3 group1Path
  class s4 group0Fixed
